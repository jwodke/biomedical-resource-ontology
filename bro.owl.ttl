                             rdfs:label "DEPRECATED Grant Preparation Expertise" ;
                             rdfs:seeAlso :P3008 ;
                             owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graph_Algorithm
:Graph_Algorithm rdf:type owl:Class ;
                 rdfs:subClassOf :Algorithm ;
                 desc:definition "Resource that provides access to methods of analysis or generation of networks and graph data structures." ;
                 rdfs:label "Graph Algorithm" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graph_Alignment
:Graph_Alignment rdf:type owl:Class ;
                 rdfs:subClassOf :Graph_Algorithm ;
                 desc:definition "Resource that provides access to a graph algorithm that compares the similarity of graphs to each other." ;
                 rdfs:label "Graph Alignment" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graph_Analysis
:Graph_Analysis rdf:type owl:Class ;
                rdfs:subClassOf :Graph_Algorithm ;
                desc:definition "Resource that provides access to software, applications, or toolkit that analyze biological graphs." ;
                rdfs:label "Graph Analysis" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graph_Viewer
:Graph_Viewer rdf:type owl:Class ;
              rdfs:subClassOf :Visualization .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graph_Viewers
:Graph_Viewers rdf:type owl:Class ;
               rdfs:subClassOf :Interactive_Tools .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graphical_Composition
:Graphical_Composition rdf:type owl:Class ;
                       rdfs:subClassOf :Interactive_Tool ;
                       desc:definition "Resource that provides access to software, application, or toolkit that enable graphical composition of applications." ;
                       rdfs:label "Graphical Composition" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graphical_Integration
:Graphical_Integration rdf:type owl:Class ;
                       rdfs:subClassOf :Integration ;
                       desc:definition "Resource that provides access to software, application, or toolkit that enables software or application integration using graphical methods." ;
                       rdfs:label "Graphical Integration" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Graphical_Processing_Workflow_Environments
:Graphical_Processing_Workflow_Environments rdf:type owl:Class ;
                                            rdfs:subClassOf :Pipeline_Manager ;
                                            desc:definition "Resource that provides access to software, applications, or toolkits that enable integration and interoperability tools that facilitate communication between software tools via graphical workflow pipelines." ;
                                            rdfs:label "Graphical Processing Workflow Environments" ;
                                            skos:editorialNote "pending final vetting: review definition" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Grid_Computing
:Grid_Computing rdf:type owl:Class ;
                rdfs:subClassOf :Computational_Service ;
                desc:definition "A resource that provides a combination of computational resources from multiple administrative domains, applied to a common task. " ;
                rdfs:label "Grid Computing" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Heat_Map
:Heat_Map rdf:type owl:Class ;
          rdfs:subClassOf :Visualization ;
          desc:definition "Resource that provides access to an interactive visualization tool that represents variables in a 2-D graph as colors." ;
          rdfs:label "Heat Map" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Heterogeneous_Funding_Resource
:Heterogeneous_Funding_Resource rdf:type owl:Class ;
                                rdfs:subClassOf :Deprecated_Resource .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Hierarchical_Tree
:Hierarchical_Tree rdf:type owl:Class ;
                   rdfs:subClassOf :Hyperbolic_Graph ;
                   desc:definition "Resource that provides access to viewers of directed, acyclic tree-structures." ;
                   rdfs:label "Hierarchical Tree" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#High_Dimensional_Data
:High_Dimensional_Data rdf:type owl:Class ;
                       rdfs:subClassOf :Deprecated_Resource .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Homology_Modeling
:Homology_Modeling rdf:type owl:Class ;
                   rdfs:subClassOf :Molecular_Modeling_and_Classification ;
                   desc:definition "Resource that provides access to software, applications, or toolkits that uses a proteins amino acid sequence and an experimental three-dimensional structure of a related homologous protein to generate an atomic-resolution model of the protein." ;
                   rdfs:label "Homology Modeling" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Hosting
:Hosting rdf:type owl:Class ;
         rdfs:subClassOf :Computational_Service ;
         desc:definition "A resource that provides a server for data or programs that another computer can access by means of a network." ;
         rdfs:label "Hosting" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Human_Embryonic_Stem_Cell_Resource
:Human_Embryonic_Stem_Cell_Resource rdf:type owl:Class ;
                                    rdfs:subClassOf :Regulatory_Compliance_Resource ;
                                    desc:definition "A resource that provides guidance and information regarding the use of embryos or human embryonic stem cells in research." ;
                                    rdfs:label "Human Embryonic Stem Cell Resource" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Human_Studies_Compliance_Resource
:Human_Studies_Compliance_Resource rdf:type owl:Class ;
                                   rdfs:subClassOf :Regulatory_Compliance_Resource ;
                                   desc:definition "A resource that provides guidelines and information related to research involving humans with the aim to protect the rights and welfare of research subjects. Such resources could supply consent forms, patient questionnaires, assist in ethical protocol designs, host seminars on conducting human studies, etc." ;
                                   rdfs:label "Human Studies Compliance Resource" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Hyperbolic_Graph
:Hyperbolic_Graph rdf:type owl:Class ;
                  rdfs:subClassOf :Graph_Viewer ;
                  desc:definition "Resource that provides access to hyperbolic space (hierarchical) graph/tree visualization tools." ;
                  rdfs:label "Hyperbolic Graph" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Hypothesis_Testing_Algorithm
:Hypothesis_Testing_Algorithm rdf:type owl:Class ;
                              rdfs:subClassOf :Statistical_Algorithm ;
                              desc:definition "Resource that provides access to tools or functions for testing statistical hypothesis against data." ;
                              rdfs:label "Hypothesis Testing Algorithm" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I1001
:I1001 rdf:type owl:Class ;
       rdfs:subClassOf :R0001 ;
       rdfs:label "Information Resource"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C16048> ;
       skos:altLabel "IR" ;
       skos:definition "A 'Resource' that provides access to sources of knowledge in the form of data, metadata, or narrative."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I2002
:I2002 rdf:type owl:Class ;
       rdfs:subClassOf :I1001 ;
       rdfs:comment "They are not organised in a complex manner that makes easy computer analysis possible. However, they may have information associated with them, such as metadata tagging that allows elements contained to be addressed."@en ;
       rdfs:label "Semi-Structured IR"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/T4FS_0000431> ;
       skos:altLabel "Semi-Structured Information Resource"@en ;
       skos:definition "An 'Information Resource' that has some organizational properties (like keys or labels), but does not follow a strict schema."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I2002 ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "They are not organised in a complex manner that makes easy computer analysis possible. However, they may have information associated with them, such as metadata tagging that allows elements contained to be addressed."@en ;
   rdfs:seeAlso "https://terms.codata.org/rdmt/semi-structured-data"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I2003
:I2003 rdf:type owl:Class ;
       rdfs:subClassOf :I1001 ;
       rdfs:comment "The 'Structured IR' can be minimally to highly expressive, such that the elements can be easily addressed, organised, and accessed in various combinations to make better use of the information."@en ;
       rdfs:label "Structured IR"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/T4FS_0000295> ;
       skos:altLabel "Structured Information Resource" ;
       skos:definition "An 'Information Resource' arranged according to some predefined semantic or technical framework."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I2003 ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "The 'Structured IR' can be minimally to highly expressive, such that the elements can be easily addressed, organised, and accessed in various combinations to make better use of the information."@en ;
   rdfs:seeAlso "https://terms.codata.org/rdmt/structured-data"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I2011
:I2011 rdf:type owl:Class ;
       rdfs:subClassOf :I1001 ;
       rdfs:comment "They are difficult to use for computer analyses."@en ;
       rdfs:label "Unstructured IR"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/T4FS_0000420> ;
       skos:altLabel "Unstructured Information Resource"@en ;
       skos:definition "An 'Information Resource' that does not follow a strictly predefined data structure nor has organizational properties. These data can often be searched as long as they are digital, but they are not properly machine-readable."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3004
:I3004 rdf:type owl:Class ;
       rdfs:subClassOf :I2003 ;
       rdfs:label "Computational Model IR"@en ;
       rdfs:seeAlso <http://identifiers.org/mamo/MAMO_0000023> ;
       skos:altLabel "Computational Model Information Resource"@en ;
       skos:definition "An computationally executable 'Structured IR' that provides with a simplified or symbolic representation of a system or phenomenon. It is often used to study the behavior of this system or a phenomenon."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3005
:I3005 rdf:type owl:Class ;
       rdfs:subClassOf :I2003 ;
       rdfs:label "Database IR"@en ;
       rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D019991> ;
       skos:altLabel "Database Information Resource"@en ;
       skos:definition "A 'Structured IR' of electronic data, designed to enable efficient storage, management, updating, and retrieval of information."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I3005 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Structured IR' of electronic data, designed to enable efficient storage, management, updating, and retrieval of information."@en ;
   rdfs:seeAlso "https://terms.codata.org/rdmt/database"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3008
:I3008 rdf:type owl:Class ;
       rdfs:subClassOf :I2003 ;
       rdfs:label "Ontology IR"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C21270> ;
       skos:altLabel "Ontology Information Resource"@en ;
       skos:definition "A 'Structured IR' that encompasses a formal representation of a domain of knowledge. It is a hierarchical structure of concepts, references, and relations."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I3008 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Structured IR' that encompasses a formal representation of a domain of knowledge. It is a hierarchical structure of concepts, references, and relations."@en ;
   rdfs:seeAlso "https://biocypher.org/BioCypher/learn/tutorials/tutorial002_handling_ontologies/"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3009
:I3009 rdf:type owl:Class ;
       rdfs:subClassOf :I2003 ;
       rdfs:comment "It was decided to include “Repository IR” in “Structured IR” instead of “Semi-Structured IR” because the structure within this repository is decisive, not the type of files that can be stored in it."@en ;
       rdfs:label "Repository IR"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/T4FS_0000489> ;
       skos:altLabel "Repository Information Resource"@en ;
       skos:definition "A 'Structured IR' that collects data, code, and other files to enable cooperative work with revision history."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I3009 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Structured IR' that collects data, code, and other files to enable cooperative work with revision history."@en ;
   rdfs:seeAlso "https://docs.github.com/en/repositories/creating-and-managing-repositories/about-repositories"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3010
:I3010 rdf:type owl:Class ;
       rdfs:subClassOf :I2003 ;
       rdfs:comment "Having and manifesting a clearly defined structure or organization that allows it to be executed."@en ;
       rdfs:label "Structured File IR"@en ;
       skos:altLabel "Structured File Information Resource"@en ;
       skos:definition "A 'Structured IR' that encompasses an electronic document being machine-readable."@en ;
       skos:example "JSON, XML, code script" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3012
:I3012 rdf:type owl:Class ;
       rdfs:subClassOf :I2011 ;
       rdfs:label "Audio IR"@en ;
       rdfs:seeAlso <http://semanticscience.org/resource/SIO_001168> ;
       skos:altLabel "Audio Information Resource"@en ;
       skos:definition "An 'Unstructured IR' that gives a recording or creation of soundwaves."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3013
:I3013 rdf:type owl:Class ;
       rdfs:subClassOf :I2011 ;
       rdfs:label "Image IR"@en ;
       skos:altLabel "Image Information Resource"@en ;
       skos:definition "An 'Unstructured IR' that gives a visual representation of data."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3016
:I3016 rdf:type owl:Class ;
       rdfs:subClassOf :I2011 ;
       rdfs:comment "It can be non-fictional or fictional."@en ;
       rdfs:label "Narrative IR"@en ;
       skos:altLabel "Narrative Information Resource"@en ;
       skos:definition "An 'Unstructured IR' that is a written account of research, events or experiences."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I3016 ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "It can be non-fictional or fictional."@en ;
   rdfs:seeAlso "https://en.wikipedia.org/wiki/Narrative"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I3021
:I3021 rdf:type owl:Class ;
       rdfs:subClassOf :I2011 ;
       rdfs:label "Video IR"@en ;
       skos:altLabel "Video Information Resource"@en ;
       skos:definition "An 'Unstructured IR' that gives a moving visual representation of data."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I4006
:I4006 rdf:type owl:Class ;
       rdfs:subClassOf :I3005 ;
       rdfs:label "noSQL DB"@en ;
       skos:altLabel "noSQL Database"@en ;
       skos:definition "A type of 'Database IR' that uses a single structure to store, manipulate and retrieve information. Structure types can be objects, key-value pairs, graphs, documents etc."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I4006 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A type of 'Database IR' that uses a single structure to store, manipulate and retrieve information. Structure types can be objects, key-value pairs, graphs, documents etc."@en ;
   rdfs:seeAlso "https://en.wikipedia.org/wiki/NoSQL"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I4007
:I4007 rdf:type owl:Class ;
       rdfs:subClassOf :I3005 ;
       rdfs:comment "It is displayed in tabular format."@en ;
       rdfs:label "SQL DB"@en ;
       skos:altLabel "SQL Database"@en ;
       skos:definition "A type of 'Database IR' that uses a specific entity-relation data model to store, manipulate and retrieve data."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I4014
:I4014 rdf:type owl:Class ;
       rdfs:subClassOf :I3013 ;
       rdfs:label "Three D Image IR"@en ;
       skos:altLabel "Three Dimensional Image Information Resource"@en ;
       skos:definition "An 'Image IR' that has the spatial dimensions length, width, and depth."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I4015
:I4015 rdf:type owl:Class ;
       rdfs:subClassOf :I3013 ;
       rdfs:label "Two D Image IR"@en ;
       skos:altLabel "Two Dimensional Image Information Resource"@en ;
       skos:definition "An 'Image IR' that has the spatial dimensions length and width."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I4017
:I4017 rdf:type owl:Class ;
       rdfs:subClassOf :I3016 ;
       owl:disjointWith :I4020 ;
       rdfs:label "Published IR"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C48471> ;
       skos:altLabel "Published Information Resource"@en ;
       skos:definition "A 'Narrative IR' that has been formally released, distributed, or made publicly available through established publication channels, typically with editorial oversight, formatting, and distribution mechanisms that distinguish it from 'Unpublished IR'."@en ;
       skos:example "book, paper, blog, newspaper, website"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I4020
:I4020 rdf:type owl:Class ;
       rdfs:subClassOf :I3016 ;
       rdfs:label "Unpublished IR"@en ;
       rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D022902> ;
       skos:altLabel "Unpublished Information Resource"@en ;
       skos:definition "A 'Narrative IR' that exists in private, informal, or preliminary stages without formal release, distribution, or public availability through established publication channels."@en ;
       skos:example "unfinished paper, results, personal journal"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I5018
:I5018 rdf:type owl:Class ;
       rdfs:subClassOf :I4017 ;
       owl:disjointWith :I5019 ;
       rdfs:label "Peer-reviewed IR"@en ;
       skos:altLabel "Peer-reviewed Information Resource"@en ;
       skos:definition "A 'Published IR' that has been accepted in a journal and has been evaluated by one or more domain experts in the sense of a 'Professional PR'."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :I5018 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Published IR' that has been accepted in a journal and has been evaluated by one or more domain experts in the sense of a 'Professional PR'."@en ;
   :mentions :P2003
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#I5019
:I5019 rdf:type owl:Class ;
       rdfs:subClassOf :I4017 ;
       rdfs:label "Unreviewed IR"@en ;
       skos:altLabel "Unreviewed Information Resource"@en ;
       skos:definition "A 'Published IR' that has been released without being evaluated."@en .


