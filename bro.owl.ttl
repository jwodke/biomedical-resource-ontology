:Mass_Spectra_Identification rdf:type owl:Class ;
                             rdfs:subClassOf :Searching_Sorting_and_Indexing ;
                             desc:definition "Resource that provides access to software, applications, or toolkits that calculates mass spectra sequence and related data from experimental mass spectra data." ;
                             rdfs:label "Mass Spectra Identification" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Mass_Spectrometer
:Mass_Spectrometer rdf:type owl:Class ;
                   rdfs:subClassOf :Instrument ;
                   desc:definition "A mass spectrometer is an instrument which is used to measure the mass to charge ratio of ions. All mass spectrometers consist of three basic parts: an ion source, a mass analyzer, and a detector system." ;
                   rdfs:label "Mass Spectrometer" ;
                   skos:editorialNote "pending final vetting: work with eagle-i to define terms since out of scope of BRO" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Material_Analysis_Service
:Material_Analysis_Service rdf:type owl:Class ;
                           rdfs:subClassOf :Computational_Service ;
                           desc:definition "A resource that provides data from any material sample that was given to the service provider. This can also be a service which performs an experiment such as electrophysiological examination of LTP magnitude in the presence of a drug given to the service provider. Viewing this as an input/output relationship the input would involve a drug and the output would be data such as a dose response curve." ;
                           rdfs:label "Material Analysis Service" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Material_Resource
:Material_Resource rdf:type owl:Class ;
                   rdfs:comment "DEPRECATED As per alignment with NIF resource type hierarchy." ,
                                "change of definition and IRI" ;
                   rdfs:label "DEPRECATED Material Resource" ;
                   rdfs:seeAlso :M1001 ;
                   owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Material_Service
:Material_Service rdf:type owl:Class ;
                  rdfs:subClassOf :S1001 ;
                  desc:definition "A resource that provides a service the output of which is a material object. That material object might be an instrument, a chemical, or an animal." ;
                  rdfs:label "Material Service" .


