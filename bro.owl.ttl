###  http://bioportal.bioontology.org/ontologies/BRO.owl#M1001
:M1001 rdf:type owl:Class ;
       rdfs:subClassOf :R0001 ;
       rdfs:label "Material Resource"@en ;
       skos:altLabel "MR" ;
       skos:definition "A 'Resource' provided of something physical to be used for testing, analysis, inspection, investigation, demonstration, or trial use."@en ;
       skos:example "an individual from a population, a device or a portion of a substance"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :M1001 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Resource' provided of something physical to be used for testing, analysis, inspection, investigation, demonstration, or trial use."@en ;
   rdfs:seeAlso "https://biolink.github.io/biolink-model/MaterialSample/"
 ] .


