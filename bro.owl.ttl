###  http://bioportal.bioontology.org/ontologies/BRO.owl#S1001
BRO:S1001 rdf:type owl:Class ;
          rdfs:subClassOf BRO:R0001 ;
          rdfs:comment "An organized system of apparatus, appliances, technology, personnel, performance, etc. It references to the provider, who performs the task for a service consumer."@en ;
          rdfs:label "Service Resource"@en ;
          skos:altLabel "SR" ;
          skos:definition "A 'Resource' providing access to an act of supporting activity, consisting in a defined system for access to and conditions for the offered support."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S2002
BRO:S2002 rdf:type owl:Class ;
          rdfs:subClassOf BRO:S1001 ;
          rdfs:comment "This includes specialized devices, technologies and/or professional support, and usually services and space for this particular purpose."@en ;
          rdfs:label "Core Facility"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C15896> ;
          skos:definition "A 'Service Resource' that provides expert support (knowledge and devices) for a specific type of tasks."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S2011
BRO:S2011 rdf:type owl:Class ;
          rdfs:subClassOf BRO:S1001 ;
          rdfs:label "Data Management SR"@en ;
          skos:altLabel "Data Management Service Resource"@en ;
          skos:definition "A 'Service Resource' that provides assistance or guidelines along the data life cycle."@en ;
          skos:example <http://purl.obolibrary.org/obo/T4FS_0000447> ,
                       "Data Storage Service"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S2012
BRO:S2012 rdf:type owl:Class ;
          rdfs:subClassOf BRO:S1001 ;
          rdfs:label "Material Storage SR"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/OBI_0001557> ;
          skos:altLabel "Material Storage Service Resource"@en ;
          skos:definition "A 'Service Resource' that provides storage, maintenance, and retrieval of 'Material Resource's."@en ;
          skos:example "Harvard brain tissue bank"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:S2012 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Service Resource' that provides storage, maintenance, and retrieval of 'Material Resource's."@en ;
   BRO:mentions BRO:M1001
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S2013
BRO:S2013 rdf:type owl:Class ;
          rdfs:subClassOf BRO:S1001 ;
          rdfs:comment "It can include both materials and documentation along with expertise in the form of personnel."@en ;
          rdfs:label "Regulatory Compliance SR"@en ;
          skos:altLabel "Regulatory Compliance Service Resource"@en ;
          skos:definition "A 'Service Resource' that provides guidance related to ethical or legal matters, including information provision and regulation application support."@en ;
          skos:example "Protocol Statement that study was conducted according to Good Clinical Practice (GCP) guidelines, Animal Compliance Resource, Environmental Health and Safety Resource, Intellectual Property Resource"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S2014
BRO:S2014 rdf:type owl:Class ;
          rdfs:subClassOf BRO:S1001 ;
          rdfs:label "Technical Support SR"@en ;
          skos:altLabel "Technical Support Service Resource"@en ;
          skos:definition "A 'Service Resource' in which the service provider offers assistance with 'Tool Resource's in their correct installation, maintenance, operation, and repair."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:S2014 ;
   owl:annotatedProperty skos:definition ;
