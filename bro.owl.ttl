:P3004 rdf:type owl:Class ;
       rdfs:subClassOf :P2003 ;
       rdfs:label "Administrative Expertise PR"@en ;
       rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D000288> ;
       skos:altLabel "Administrative Expertise People Resource"@en ;
       skos:definition "A 'Professional PR' trained in policy and governance, project management, and other supportive tasks required in biomedical organizations."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P3005
:P3005 rdf:type owl:Class ;
       rdfs:subClassOf :P2003 ;
       rdfs:comment "Enabling them to provide expert diagnosis, treatment, and patient care services."@en ;
       rdfs:label "Clinical Expertise PR"@en ;
       rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D002983> ;
       skos:altLabel "Clinical Expertise People Resource"@en ;
       skos:definition "A 'Professional PR' trained in clinical medicine, healthcare delivery, or related medical fields."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P3006
:P3006 rdf:type owl:Class ;
       rdfs:subClassOf :P2003 ;
       rdfs:comment "Data created or collected in the course of research, clinical, or administrative activities. This covers the entire life cycle of data from planning the investigation to conducting it, and from backing up data as it is created and used to long term preservation of data deliverables after the research investigation has concluded."@en ,
                    "Data created or collected in the course of research, clinical, or administrative activities. This covers the entire life cycle of data from planning the investigation to conducting it, and from backing up data as it is created and used to long term preservation of data deliverables after the research investigation has concluded." ;
       rdfs:label "Data Management Expertise PR"@en ;
       skos:altLabel "Data Management People Resource"@en ;
       skos:definition "A 'Professional PR' trained in the collection, storage, access, and preservation of data along the data life cycle."@en ;
       skos:example "Specific activities and issues that fall within the category of data management include: File naming (the proper way to name computer files); data quality control and quality assurance; data access; data documentation (including levels of uncertainty); metadata creation and controlled vocabularies; data storage; data archiving and preservation; data sharing and reuse; data integrity; data security; data privacy; data rights; notebook protocols (lab or field) as required."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :P3006 ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Data created or collected in the course of research, clinical, or administrative activities. This covers the entire life cycle of data from planning the investigation to conducting it, and from backing up data as it is created and used to long term preservation of data deliverables after the research investigation has concluded." ;
   rdfs:seeAlso "https://terms.codata.org/rdmt/research-data-management"
 ] .


