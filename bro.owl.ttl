       rdfs:subClassOf :P1001 ;
       rdfs:label "Private PR"@en ;
       skos:altLabel "Private People Resource"@en ;
       skos:definition "A 'People Resource' made up by one or more laypersons, that have untrained experience or knowledge."@en ;
       skos:example "relative, patient representative, volunteer, possibly student"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P2003
:P2003 rdf:type owl:Class ;
       rdfs:subClassOf :P1001 ;
       rdfs:comment "They can have expertise in different fields of work, from preparation, development, and execution to scientific analysis."@en ;
       rdfs:label "Professional PR"@en ;
       rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D011361> ;
       skos:altLabel "Professional People Resource"@en ;
       skos:definition "A 'People Resource' made up by one or more trained persons."@en ;
       skos:example "medical staff, IT professional"@en .


