:Root_Finder rdf:type owl:Class ;
             rdfs:subClassOf :Numerical_Method ;
             desc:definition "A resource that provides access to a tool or function that finds a value x such that f(x) = 0, for a given function f. Such an x is called a root of the function f." ;
             rdfs:label "Root Finder" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S1001
:S1001 rdf:type owl:Class ;
       rdfs:subClassOf :R0001 ;
       rdfs:comment "An organized system of apparatus, appliances, technology, personnel, performance, etc. It references to the provider, who performs the task for a service consumer." ;
       rdfs:label "Service Resource" ;
       skos:altLabel "SR" ;
       skos:definition "A 'Resource' providing access to an act of supporting activity, consisting in a defined system for access to and conditions for the offered support." .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S2002
:S2002 rdf:type owl:Class ;
       rdfs:subClassOf :S1001 ;
       rdfs:comment "This includes specialized devices, technologies and/or professional support, and usually services and space for this particular purpose." ;
       rdfs:label "Core Facility" ;
       skos:definition "A 'Service Resource' that provides expert support (knowledge and devices) for a specific type of tasks." .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S3004
:S3004 rdf:type owl:Class ;
       rdfs:subClassOf :S2002 ;
       rdfs:comment "Is classified by guidelines into levels 1 to 4." ;
       rdfs:label "Biosafety Level Facility" ;
       skos:definition "A 'Core Facility' with a specialization to have taken precautions for the containement of potentially dangerous biological agents. The precautions are according to NCIT:'Biosafety Level'.." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :S3004 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Core Facility' with a specialization to have taken precautions for the containement of potentially dangerous biological agents. The precautions are according to NCIT:'Biosafety Level'.." ;
   :mentions <http://purl.obolibrary.org/obo/NCIT_C151920>
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S3005
:S3005 rdf:type owl:Class ;
       rdfs:subClassOf :S2002 ;
       rdfs:label "Cell Biology Facility" ;
       skos:definition "A 'Core Facility' with a specialization in MESH:'Cell Biology'." .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :S3005 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Core Facility' with a specialization in MESH:'Cell Biology'." ;
   :mentions <http://id.nlm.nih.gov/mesh/D003585>
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S3006
:S3006 rdf:type owl:Class ;
       rdfs:subClassOf :S2002 ;
       rdfs:label "Fabrication Facility" ;
       skos:definition "A 'Core Facility' with a specialization on creating, manufacturing, building or assembling resources from raw or intermediate materials used in scientific research." .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#S3007
:S3007 rdf:type owl:Class ;
       rdfs:subClassOf :S2002 ;
       rdfs:label "Imaging Facility" ;
       skos:definition "A 'Core Facility' with a specialization on technologies or methods that aid in the visualization of any biomedical material, data, or process." .


