                                  rdfs:subClassOf :Genomic_Phenotypic_Analysis ,
                                                  :Inference_From_Data ;
                                  desc:definition "Resource that provides access to software, applications, or toolkits that generate network maps of biological signaling networks based on applying logic and statistics to observations/hypothesis." ;
                                  rdfs:label "Signaling Network Reconstruction" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Skull_Stripping
:Skull_Stripping rdf:type owl:Class ;
                 rdfs:subClassOf :Pre-Processing ;
                 desc:definition "Resource that provides access to software, applications, or toolkits that methods for removing of segments from images, which have no valuable information about the biological object. For example, removing non-brain tissue from whole-brain MRI scans, for the purpose of doing quantitative evaluations of time or space changing brain anatomy." ;
                 rdfs:label "Skull Stripping" .


