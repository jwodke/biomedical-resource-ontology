#    Annotations
#################################################################

activity:Heath_Services desc:definition "As defined in http://en.wikipedia.org/wiki/Health_services_research" ;
                        rdfs:label "Heath Services" ;
                        rdfs:seeAlso activity:Health_Services ;
                        owl:deprecated "true"^^xsd:boolean ;
                        skos:historyNote "Deprecated for BRO v2.7" .


activity:Novel_Therapeutics desc:definition "Innovative therapeutics (http://en.wiktionary.org/wiki/therapeutics)" ;
                            rdfs:label "Novel Therapeutics" ;
                            rdfs:seeAlso activity:Therapeutics ;
                            owl:deprecated "true"^^xsd:boolean ;
                            skos:historyNote "Deprecated for BRO v2.7" .


desc:definition rdfs:comment "there is no usage anymore, skos:definition is used instead" ;
                rdfs:label "DEPRECATED Definition" ;
                rdfs:seeAlso skos:definition ;
                owl:deprecated "true"^^xsd:boolean .


desc:replacedBy rdfs:comment "there is no usage anymore, rdfs:seeAlso is used instead" ;
                rdfs:label "DEPRECATED replacedBy" ;
                rdfs:seeAlso rdfs:seeAlso ;
                owl:deprecated "true"^^xsd:boolean .


BRO:Anatomic_Atlas desc:definition "A collection of tables, charts, or plates to illustrate anatomical structures." ;
                   rdfs:label "Anatomic Atlas" ;
                   rdfs:seeAlso BRO:Atlas ;
                   owl:deprecated "true"^^xsd:boolean ;
                   skos:historyNote "Deprecated for BRO v3.0" .


BRO:Atlas rdfs:comment "Level of detail is to specific" ;
          rdfs:label "DEPRECATED Atlas" ;
          rdfs:seeAlso BRO:I2002 ;
          owl:deprecated "true"^^xsd:boolean .


BRO:Automated_Natural_Language_Output desc:definition "Data file resulting from natural language processing." ;
                                      rdfs:label "Automated Natural Language Output" ;
                                      rdfs:seeAlso BRO:Natural_Language_Processing ;
                                      owl:deprecated "true"^^xsd:boolean ;
                                      skos:historyNote "Deprecated for BRO v3.0" .


BRO:Averaging_and_Agglomeration rdfs:comment "Parentclass deprecated" ;
                                rdfs:label "DEPRECATED Averaging and Agglomeration" ;
                                rdfs:seeAlso BRO:Signal_Processing ;
                                owl:deprecated "true"^^xsd:boolean .


BRO:Averaging_and_Aglomeration desc:definition "Resource that provides access to software, applications, or toolkits that performs signal processing by repeated measures of the signal and then calculates the expected value of the data set." ;
                               rdfs:label "Averaging and Aglomeration" ;
                               rdfs:seeAlso BRO:Averaging_and_Agglomeration ;
                               owl:deprecated "true"^^xsd:boolean ;
                               skos:historyNote "Deprecated for BRO v3.0" .


BRO:Backup_Archive_Service rdfs:comment "level of detail is too specific" ;
                           rdfs:label "DEPRECATED Backup Archive Service" ;
                           rdfs:seeAlso BRO:S3015 ;
                           owl:deprecated "true"^^xsd:boolean .


BRO:Backup_Archives_and_Disaster_Recovery desc:definition "A resource that provides long-term storage for backup copies of files or for files that are no longer in active use, and the ability to retrieve backed up content in the event of a disaster that impacts the system in question," ;
                                          rdfs:label "Backup Archives and Disaster Recovery" ;
                                          rdfs:seeAlso BRO:Backup_Archive_Service ,
                                                       BRO:Disaster_Recovery_Service ;
                                          owl:deprecated "true"^^xsd:boolean ;
                                          skos:historyNote "Deprecated for BRO v3.0" .


BRO:Bibliographic_Resource rdfs:comment "level of detail is to specific" ;
                           rdfs:label "DEPRECATED Bibliographic Resource" ;
                           rdfs:seeAlso BRO:Bibliographic_Resource ,
                                        BRO:I2002 ;
                           owl:deprecated "true"^^xsd:boolean .


BRO:Binary_Executable desc:definition "Resource that provides access to Software that contains data encoded in binary form and contains instructions for the computer to perform a given set of tasks." ;
                      rdfs:label "Binary Executable" ;
                      rdfs:seeAlso BRO:Data_Resource ;
                      owl:deprecated "true"^^xsd:boolean ;
                      skos:historyNote "Deprecated for BRO v3.0" .


BRO:Biochemical_Supply_Resource desc:definition "Biochemical (http://en.wikipedia.org/wiki/Biochemistry) supplies provided for a laboratory (http://en.wikipedia.org/wiki/Laboratory)" ;
                                rdfs:label "Biochemical Supply Resource" ;
                                rdfs:seeAlso BRO:Reagent_Resource ;
                                owl:deprecated "true"^^xsd:boolean ;
                                skos:historyNote "Deprecated for BRO v2.7" .


BRO:Centrality_Analsysis desc:definition "A Resource that provides access to a graph algorithm that uses ranking of network elements to identify the importance of elements in a network." ;
                         rdfs:label "Centrality Analsysis" ;
                         rdfs:seeAlso BRO:Centrality_Analysis ;
                         owl:deprecated "true"^^xsd:boolean ;
                         skos:historyNote "Deprecated for BRO v3.0" .


BRO:Centrality_Analysis rdfs:comment "Parentclass deprecated" ;
                        rdfs:label "DEPRECATED Centrality Analysis" ;
                        rdfs:seeAlso BRO:Graph_Algorithm ;
                        owl:deprecated "true"^^xsd:boolean .


BRO:Clinical_Care_Data rdfs:comment "can be incorporated in the existing Subclasses of Information Resource" ;
                       rdfs:label "DEPRECATED Clinical Care Data" ;
                       rdfs:seeAlso BRO:Data_Resource ;
                       owl:deprecated "true"^^xsd:boolean .


BRO:Clinical_Chart desc:definition """**previously was called Clinical_Charts_eg_Demographics
we think this should be deleted""" ;
                   rdfs:label "Clinical Chart" ;
                   rdfs:seeAlso BRO:Narrative_Resource ;
                   owl:deprecated "true"^^xsd:boolean ;
                   skos:historyNote "Deprecated for BRO v3.0" .


BRO:Clinical_Charts desc:definition """**previously was called Clinical_Charts_eg_Demographics
we think this should be deleted""" ;
                    rdfs:label "Clinical Charts" ;
                    rdfs:seeAlso BRO:Clinical_Chart ;
                    owl:deprecated "true"^^xsd:boolean ;
                    skos:historyNote "Deprecated for BRO v2.7" .


BRO:Clinical_Data desc:definition "Any type of data obtained in the course of caring for humans." ;
                  rdfs:label "Clinical Data" ;
                  rdfs:seeAlso BRO:Clinical_Care_Data ;
                  owl:deprecated "true"^^xsd:boolean ;
                  skos:historyNote "Deprecated for BRO v3.0" .


BRO:Clinical_Research_Data rdfs:comment "can be incorporated in the existing Subclasses of Information Resource" ;
                           rdfs:label "DEPRECATED Clinical Research Data" ;
                           rdfs:seeAlso BRO:Data_Resource ;
                           owl:deprecated "true"^^xsd:boolean .


BRO:Clinical_Trial_Data desc:definition "A resource the provides access to data about subjects in a clinical trial; for example demographics, medical history, labs, procedures, etc." ;
                        rdfs:label "Clinical Trial Data" ;
                        rdfs:seeAlso BRO:Clinical_Research_Data ;
                        owl:deprecated "true"^^xsd:boolean ;
                        skos:historyNote "Deprecated for BRO v3.0" .


BRO:Computational_Service rdfs:comment "change in hierarchy, definition and IRI" ;
                          rdfs:label "DEPRECATED Computational Service" ;
                          rdfs:seeAlso BRO:S3015 ;
                          owl:deprecated "true"^^xsd:boolean .


BRO:Connectivity_Matrix desc:definition "A matrix is a subset of a network that contains node-edge-node connections of interest and are represented as a matrix." ;
                        rdfs:label "Connectivity Matrix" ;
                        rdfs:seeAlso BRO:Data_Resource ;
                        owl:deprecated "true"^^xsd:boolean ;
                        skos:historyNote "Deprecated for BRO v3.0" .


BRO:Continuous_Data desc:definition "A data object that has infinite numbers of possible values. Quantitative data is often continuous such as weight, blood pressure." ;
                    rdfs:label "Continuous Data" ;
                    rdfs:seeAlso BRO:Data_Resource ;
                    owl:deprecated "true"^^xsd:boolean ;
                    skos:historyNote "Deprecated for BRO v3.0" .


BRO:Data_Distribution desc:definition "A resource that provides data or allows users to access and utilize data" ;
                      rdfs:label "Data Distribution" ;
                      rdfs:seeAlso BRO:Data_Resource ;
                      owl:deprecated "true"^^xsd:boolean ;
                      skos:historyNote "Deprecated for BRO v3.0" .


BRO:Data_Editor rdfs:comment "Parentclass deprecated" ;
