@prefix : <http://bioportal.bioontology.org/ontologies/BRO.owl#> .
@prefix BRO: <http://bioportal.bioontology.org/ontologies/BRO.owl#> .
@prefix dct: <http://www.dublincore.org/specifications/dublin-core/dcmi-terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xsp: <http://www.owl-ontologies.com/2005/08/07/xsp.owl#> .
@prefix area: <http://bioontology.org/ontologies/ResearchArea.owl#> .
@prefix desc: <http://bioontology.org/ontologies/biositemap.owl#> .
