                       rdfs:label "DEPRECATED Gene Therapy Facility" ;
                       rdfs:seeAlso :S3005 ;
                       owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Genomic_Phenotypic_Analysis
:Genomic_Phenotypic_Analysis rdf:type owl:Class ;
                             rdfs:subClassOf :Data_Analysis_Software ;
                             desc:definition """A resource that provides access to software or application that is used to analyze and model biological processes at the genomic, molecular, cellular, tissue level, or population levels.

""" ;
                             rdfs:label "Genomic Phenotypic Analysis" .


