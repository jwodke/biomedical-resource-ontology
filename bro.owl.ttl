###  http://bioportal.bioontology.org/ontologies/BRO.owl#Expertise
:Expertise rdf:type owl:Class ;
           rdfs:subClassOf :Non_Computational_Service .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Exploratory_Data_Analysis
:Exploratory_Data_Analysis rdf:type owl:Class ;
                           rdfs:subClassOf :Image_Processing .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F1001
:F1001 rdf:type owl:Class ;
       rdfs:subClassOf :R0001 ;
       rdfs:label "Financial Resource"@en ;
       skos:altLabel "FR"@en ;
       skos:definition "A 'Resource' that provides access to monetary support for research, training, or education, including to grants, contracts, materials, or gifts."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F2002
:F2002 rdf:type owl:Class ;
       rdfs:subClassOf :F1001 ;
       rdfs:label "Internal FR"@en ;
       skos:altLabel "Internal Financial Resource"@en ;
       skos:definition "A 'Financial Resource' provided from within the organizational unit, organization, or institution of the applicant."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F2003
:F2003 rdf:type owl:Class ;
       rdfs:subClassOf :F1001 ;
       rdfs:label "Third Party FR"@en ;
       skos:altLabel "Third Party Financial Resource"@en ;
       skos:definition "A 'Financial Resource' provided by an external party."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F3004
:F3004 rdf:type owl:Class ;
       rdfs:subClassOf :F2003 ;
       rdfs:comment "This does not have to be by the public sector where the usage of the 'Financial Resource' is taking place."@en ;
       rdfs:label "Public FR"@en ;
       rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C102434> ;
       skos:altLabel "Public Financial Resource"@en ;
       skos:definition "A 'Third Party FR' provided by a public sector, including the local, city, county, state and federal government, or a transnational group."@en ;
       skos:example "Public Health Care, EU Funding"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F3008
:F3008 rdf:type owl:Class ;
       rdfs:subClassOf :F2003 ;
       rdfs:label "Private FR"@en ;
       skos:altLabel "Private Financial Resource"@en ;
       skos:definition "A 'Third Party FR' provided by a person or organization not from the public sector. It could be made of investments, donations, loans or crowdfunding."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4005
:F4005 rdf:type owl:Class ;
       rdfs:subClassOf :F3004 ;
       rdfs:label "Federal FR"@en ;
       skos:altLabel "Federal Financial Resource"@en ;
       skos:definition "A 'Public FR' provided from the central government of a country or one of its organizations."@en ;
       skos:example "Funding by German Federal Ministry of Research, Technology and Space"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4006
:F4006 rdf:type owl:Class ;
       rdfs:subClassOf :F3004 ;
       rdfs:label "International FR"@en ;
       skos:altLabel "International Financial Resource"@en ;
       skos:definition "A 'Public FR' provided by public institutions of and/or given to beneficiaries from several countries or a transnational group."@en ;
       skos:example "EU Funding"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4007
:F4007 rdf:type owl:Class ;
       rdfs:subClassOf :F3004 ;
       rdfs:label "State FR"@en ;
       skos:altLabel "State Financial Resource"@en ;
       skos:definition "A 'Public FR' provided by a state or one of its organizations."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4009
:F4009 rdf:type owl:Class ;
       rdfs:subClassOf :F3008 ;
       owl:disjointWith :F4010 ;
       rdfs:label "Institutional FR"@en ;
       skos:altLabel "Institutional Financial Resource"@en ;
       skos:definition "A 'Private FR' provided by a company, organization or foundation."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4010
:F4010 rdf:type owl:Class ;
       rdfs:subClassOf :F3008 ;
       rdfs:label "Personal FR"@en ;
       skos:altLabel "Personal Financial Resource"@en ;
       skos:definition "A 'Private FR' provided by one or more human individuals."@en ;
       skos:example "FR by a natural person, foundation of a single person, married couple"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Fabrication_Facility
:Fabrication_Facility rdf:type owl:Class ;
                      rdfs:comment "change of definition and IRI" ;
                      rdfs:label "DEPRECATED Fabrication Facility" ;
                      rdfs:seeAlso :S3006 ;
                      owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Facility_Core
:Facility_Core rdf:type owl:Class ;
               rdfs:comment "DEPRECATED As defined in http://dictionary.reference.com/browse/facility" ,
                            "change of label, IRI and definition" ;
               rdfs:label "DEPRECATED Facility Core" ;
               rdfs:seeAlso :S2002 ;
               owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Faraday_Cage
:Faraday_Cage rdf:type owl:Class ;
              rdfs:subClassOf :Instrument ;
              desc:definition "An enclosure, formed by conducting material or by a mesh of such material, that blocks out external static electric fields." ;
              rdfs:label "Faraday Cage" ;
              skos:editorialNote "pending final vetting: work with eagle-i to define terms since out of scope of BRO" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Fast_Fourier_Transform
:Fast_Fourier_Transform rdf:type owl:Class ;
                        rdfs:subClassOf :Image_Algorithm ,
                                        :Numerical_Method ;
                        desc:definition "Resource that provides access to tools or functions that compute the discrete Fourier transform (DFT) and its inverse." ;
                        rdfs:label "Fast Fourier Transform" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Feature_Analysis
:Feature_Analysis rdf:type owl:Class ;
                  rdfs:subClassOf :Computational_Geometry ;
                  desc:definition "Resource that provides access to methods for automated analysis of object features and quantitative characterization of data." ;
                  rdfs:label "Feature Analysis" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Feature_Request
:Feature_Request rdf:type owl:Class ;
                 rdfs:subClassOf :Interactive_Web-Based_Tool ;
                 desc:definition "Resource that provides access to software, application, or toolkit that enable interactive web-based tool that has functionality to collect a request for new features for a specified tool. " ;
                 rdfs:label "Feature Request" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Federal_Funding_Resource
:Federal_Funding_Resource rdf:type owl:Class ;
                          rdfs:comment "Change in definition, IRI and hierachy" ;
                          rdfs:label "DEPRECATED Federal Funding Resource" ;
                          rdfs:seeAlso :F4005 ;
                          owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Filtering
:Filtering rdf:type owl:Class ;
           rdfs:subClassOf :Pre-Processing ;
           desc:definition "Resource that provides access to software, applications, or toolkits that perform alter the spatial-temporal spectral content of data." ;
           rdfs:label "Filtering" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Finite_Element_Model
:Finite_Element_Model rdf:type owl:Class ;
                      rdfs:subClassOf :Modeling_and_Simulation ;
                      desc:definition "Resource that provides access to software, applications, or toolkits that can be used to generate approximate solutions of partial differential equations." ;
                      rdfs:label "Finite Element Model" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Flatfile_Distribution
:Flatfile_Distribution rdf:type owl:Class ;
                       rdfs:comment "level of detail is too specific" ;
                       rdfs:label "DEPRECATED Flatfile Distribution" ;
                       rdfs:seeAlso :Structured_File ;
                       owl:deprecated "true"^^xsd:boolean .


