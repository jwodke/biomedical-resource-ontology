###  http://bioportal.bioontology.org/ontologies/BRO.owl#M1001
BRO:M1001 rdf:type owl:Class ;
          rdfs:subClassOf BRO:R0001 ;
          rdfs:label "Material Resource"@en ;
          skos:altLabel "MR" ;
          skos:definition "A 'Resource' provided of something physical to be used for testing, analysis, inspection, investigation, demonstration, or trial use."@en ;
          skos:example "an individual from a population, a device or a portion of a substance"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:M1001 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Resource' provided of something physical to be used for testing, analysis, inspection, investigation, demonstration, or trial use."@en ;
   rdfs:seeAlso "https://biolink.github.io/biolink-model/MaterialSample/"
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#M2002
BRO:M2002 rdf:type owl:Class ;
          rdfs:subClassOf BRO:M1001 ;
          rdfs:label "Living MR"@en ;
          skos:altLabel "Living Material Resource"@en ;
          skos:definition "A 'Material Resource' of biological origin."@en ;
          skos:example <http://purl.obolibrary.org/obo/mesh#B> .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#M2009
BRO:M2009 rdf:type owl:Class ;
          rdfs:subClassOf BRO:M1001 ;
          rdfs:comment "Removed sub-categories, because only unclear distinctions are possible in the field of biomedicine. Since subfield are extremly large and heterogeneous in their use of terms, only a upper-level category is given here."@en ;
          rdfs:label "Non-living MR"@en ;
          skos:altLabel "Non-living Material Resource"@en ;
          skos:definition "Any 'Material Resource' of non-biological origin."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#M3003
BRO:M3003 rdf:type owl:Class ;
