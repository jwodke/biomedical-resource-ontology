###  http://bioportal.bioontology.org/ontologies/BRO.owl#P1001
BRO:P1001 rdf:type owl:Class ;
          rdfs:subClassOf BRO:R0001 ;
          rdfs:comment "Not the contact is meant, but the person itself."@en ;
          rdfs:label "People Resource"@en ;
          skos:altLabel "PR"@en ;
          skos:definition "A 'Resource' comprised of one or more individuals providing or exchanging knowledge, experience, or skills in a specific domain."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P2002
BRO:P2002 rdf:type owl:Class ;
          rdfs:subClassOf BRO:P1001 ;
          rdfs:label "Private PR"@en ;
          skos:altLabel "Private People Resource"@en ;
          skos:definition "A 'People Resource' made up by one or more laypersons, that have untrained experience or knowledge."@en ;
          skos:example "relative, patient representative, volunteer, possibly student"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P2003
BRO:P2003 rdf:type owl:Class ;
          rdfs:subClassOf BRO:P1001 ;
          rdfs:comment "They can have expertise in different fields of work, from preparation, development, and execution to scientific analysis."@en ;
          rdfs:label "Professional PR"@en ;
          rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D011361> ;
          skos:altLabel "Professional People Resource"@en ;
          skos:definition "A 'People Resource' made up by one or more trained persons."@en ;
          skos:example "medical staff, IT professional"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P3004
BRO:P3004 rdf:type owl:Class ;
          rdfs:subClassOf BRO:P2003 ;
          rdfs:label "Administrative Expertise PR"@en ;
          rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D000288> ;
          skos:altLabel "Administrative Expertise People Resource"@en ;
          skos:definition "A 'Professional PR' trained in policy and governance, project management, and other supportive tasks required in biomedical organizations."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P3005
BRO:P3005 rdf:type owl:Class ;
          rdfs:subClassOf BRO:P2003 ;
          rdfs:comment "Enabling them to provide expert diagnosis, treatment, and patient care services."@en ;
          rdfs:label "Clinical Expertise PR"@en ;
          rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D002983> ;
          skos:altLabel "Clinical Expertise People Resource"@en ;
          skos:definition "A 'Professional PR' trained in clinical medicine, healthcare delivery, or related medical fields."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#P3006
BRO:P3006 rdf:type owl:Class ;
          rdfs:subClassOf BRO:P2003 ;
          rdfs:comment "'Professional PR' that is trained to perform 'Data Management SR'"@en ,
                       "Data created or collected in the course of research, clinical, or administrative activities. This covers the entire life cycle of data from planning the investigation to conducting it, and from backing up data as it is created and used to long term preservation of data deliverables after the research investigation has concluded."@en ;
          rdfs:label "Data Management Expertise PR"@en ;
          skos:altLabel "Data Management People Resource"@en ;
          skos:definition "A 'Professional PR' trained in the collection, storage, access, and preservation of data along the data life cycle."@en ;
          skos:example "Specific activities and issues that fall within the category of data management include: File naming (the proper way to name computer files); data quality control and quality assurance; data access; data documentation (including levels of uncertainty); metadata creation and controlled vocabularies; data storage; data archiving and preservation; data sharing and reuse; data integrity; data security; data privacy; data rights; notebook protocols (lab or field) as required."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:P3006 ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "'Professional PR' that is trained to perform 'Data Management SR'"@en ;
   BRO:mentions BRO:S2011
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:P3006 ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Data created or collected in the course of research, clinical, or administrative activities. This covers the entire life cycle of data from planning the investigation to conducting it, and from backing up data as it is created and used to long term preservation of data deliverables after the research investigation has concluded."@en ;
   rdfs:seeAlso "https://terms.codata.org/rdmt/research-data-management"
 ] .


