:Flow_Cytometry_Cell_Sorting_Facility rdf:type owl:Class ;
                                      rdfs:comment "level of detail is too specific" ;
                                      rdfs:label "DEPRECATED Flow Cytometry Cell Sorting Facility" ;
                                      rdfs:seeAlso :S3005 ;
                                      owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Four_Dimensional_Data
:Four_Dimensional_Data rdf:type owl:Class ;
                       rdfs:subClassOf :Deprecated_Resource .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Fourier_Transform
:Fourier_Transform rdf:type owl:Class ;
                   rdfs:subClassOf :Spectral_Transform ;
                   desc:definition "Resource that provides access to software, applications, or toolkits that performs Multi-dimensional Fourier transform" ;
                   rdfs:label "Fourier Transform" .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Free_Text
:Free_Text rdf:type owl:Class ;
           rdfs:subClassOf :Deprecated_Resource .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Funding_Resource
:Funding_Resource rdf:type owl:Class .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Gene_Expression
:Gene_Expression rdf:type owl:Class ;
                 rdfs:comment "Parentclass deprecated" ;
                 rdfs:label "DEPRECATED Gene Expression" ;
                 rdfs:seeAlso :Molecular_and_Cellular_Data ;
                 owl:deprecated "true"^^xsd:boolean .


