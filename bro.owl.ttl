###  http://bioportal.bioontology.org/ontologies/BRO.owl#T1001
BRO:T1001 rdf:type owl:Class ;
          rdfs:subClassOf BRO:R0001 ;
          rdfs:label "Tool Resource"@en ;
          skos:altLabel "TR"@en ;
          skos:definition "A 'Resource' that provides access to 'Information Resource's or 'Material Resource's used to gather, store, access, and analyze data."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T1001 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Resource' that provides access to 'Information Resource's or 'Material Resource's used to gather, store, access, and analyze data."@en ;
   BRO:mentions BRO:I1001 ,
                BRO:M1001
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T2002
BRO:T2002 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T1001 ;
          rdfs:comment "hardware and software can be a part of a device"@en ,
                       "in the field of healthcare and biomedical research"@en ;
          rdfs:label "Device R"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C62103> ,
                       <https://biolink.github.io/biolink-model/Device/> ;
          skos:altLabel "Device Resource"@en ;
          skos:definition "A 'Tool Resource' that provides a piece of mechanical or electronic instrument, optionally equipped with software components."@en ;
          skos:example "Calorimeter, Microscope. Next Generation Sequencer, Temperature Control Unit"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T2005
BRO:T2005 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T1001 ;
          rdfs:label "Hardware TR"@en ;
          skos:altLabel "Hardware Tool Resource"@en ;
          skos:definition "A 'Tool Resource' provided by physical, manifactured components or objects of the digital research infrastructure."@en ;
          skos:example "Central Processing Unit,  Graphics Processing Unit, Motherboard"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T2006
BRO:T2006 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T1001 ;
          rdfs:label "Software TR"@en ;
          rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D012984> ,
                       <http://purl.org/dc/dcmitype/Software> ;
          skos:altLabel "S"@en ,
                        "Software Tool Resource"@en ;
          skos:definition "An executable digital 'Tool Resource' that can be used to work digitally and is usually provided in source or compiled form."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3003
BRO:T3003 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2002 ;
          rdfs:comment "Those devices are usually designed to carry out specific functions or a set of functions."@en ;
          rdfs:label "Laboratory DR"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C203665> ;
          skos:altLabel "Laboratory Device Resource"@en ;
          skos:definition "A 'Device R' used for laboratory experiments."@en ;
          skos:example "reagents, instruments, tissue samples"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3004
BRO:T3004 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2002 ;
          rdfs:label "Medical DR"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C16830> ;
          skos:altLabel "Medical Device Resource"@en ;
          skos:definition "A 'Device R' that is useful for prevention, diagnosis, monitoring, or treatment of disease or other medical conditions."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3007
BRO:T3007 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:label "Data Access S"@en ;
          skos:altLabel "Data Access Software"@en ;
          skos:definition "A 'Software TR' used to retrieve data from an internal or external storage and to provide it to 'Data Analysis S'."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T3007 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Software TR' used to retrieve data from an internal or external storage and to provide it to 'Data Analysis S'."@en ;
   BRO:mentions BRO:T3009
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3008
BRO:T3008 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:label "Data Acquisition S"@en ;
          skos:altLabel "Data Acquisition Software"@en ;
          skos:definition "A 'Software TR' that has the purpose of EDAM:'Data Acquisition'."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T3008 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Software TR' that has the purpose of EDAM:'Data Acquisition'."@en ;
   BRO:mentions <http://edamontology.org/topic_3077>
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3009
BRO:T3009 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:label "Data Analysis S"@en ;
          rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D000078332> ,
                       <http://purl.obolibrary.org/obo/T4FS_0000352> ;
          skos:altLabel "Data Analysis Software"@en ;
          skos:definition "A 'Software TR' for inspecting, cleaning, modeling, and/or transforming data to unravel new information and knowledge about those data."@en ;
          skos:example "Data Mining and Inference S, Natural Language Processing S, Statistical Analysis S"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T3009 ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://id.nlm.nih.gov/mesh/D000078332> ;
   rdfs:comment "software with the purpose of mesh:D000078332"@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T3009 ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget <http://purl.obolibrary.org/obo/T4FS_0000352> ;
   rdfs:comment "software with the purpose of T4FS:0000352"@en
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3010
BRO:T3010 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:label "Data Integration S"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/T4FS_0000487> ;
          skos:altLabel "Data Integration Software"@en ;
          skos:definition "A 'Software TR'  with the purpose to combine diverse data from disparate sources into one unified dataset or database or to exchange data."@en ;
          skos:example "Pipeline Manager"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3011
BRO:T3011 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:comment "This includes taking care of the associated metadata, data formats, storage, preservation/archiving, access, and legal aspects related to using and sharing data."@en ;
          rdfs:label "Data Management S"@en ;
          rdfs:seeAlso <http://edamontology.org/topic_3071> ;
          skos:altLabel "Data Management Software"@en ;
          skos:definition "A 'Software TR' that organizes data consistently, easily accessible and reusable, while ensuring a required level of data protection."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3012
BRO:T3012 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:label "Data Processing S"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/T4FS_0000044> ;
          skos:altLabel "Data Processing Software"@en ;
          skos:definition "A 'Software TR' that has the purpose to convert or manipulate data at any point in the data life cycle."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3017
BRO:T3017 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:comment "quality aspects such as security, data privacy, data quality, data integrity, and audit trail"@en ;
          rdfs:label "Data Transfer and Communication S"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C209464> ;
          skos:altLabel "Data Transfer and Communication Software"@en ;
          skos:definition "A 'Software TR' for exchanging data across computer systems and networks, taking into account all required quality aspects."@en ;
          skos:example "Communication Interface"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T3018
BRO:T3018 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T2006 ;
          rdfs:label "Modeling and Simulation S"@en ;
          rdfs:seeAlso <http://edamontology.org/operation_2426> ,
                       <http://purl.obolibrary.org/obo/NCIT_C16461> ;
          skos:altLabel "Modeling and Simulation Software"@en ;
          skos:definition "A 'Software TR' that applies a defined 'Computational Model IR' and simulates it."@en ;
          skos:example "Protein Interaction Modeling, Numerical Model, Random Number Simulation"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T3018 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Software TR' that applies a defined 'Computational Model IR' and simulates it."@en ;
   BRO:mentions BRO:I3004
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T4013
BRO:T4013 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T3012 ;
          rdfs:comment "It is used to allow the output of data or to transform data into a form that will allow to link different applications."@en ;
          rdfs:label "Adapter"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C73536> ;
          skos:definition "A 'Data Processing S' to convert or manipulate the representation and or the format of data."@en ;
          skos:example "png to pdf converter"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T4014
BRO:T4014 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T3012 ;
          rdfs:comment "Both compression with and without loss is meant."@en ;
          rdfs:label "Data Compression S"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C64347> ;
          skos:altLabel "Data Compression Software"@en ;
          skos:definition "A 'Data Processing S' for reducing the data size."@en ;
          skos:example "7-zip"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T4015
BRO:T4015 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T3012 ;
          rdfs:label "Data Visualization S"@en ;
          rdfs:seeAlso <http://id.nlm.nih.gov/mesh/D000078326> ;
          skos:altLabel "Data Visualization Software"@en ;
          skos:definition "A 'Data Processing S' for representing data or information as an 'Image IR'."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T4015 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Data Processing S' for representing data or information as an 'Image IR'."@en ;
   BRO:mentions BRO:I3013
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T4016
BRO:T4016 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T3012 ;
          rdfs:label "Image Processing S"@en ;
          skos:altLabel "Image Processing Software"@en ;
          skos:definition "A 'Data Processing S' for performing post-processing on an 'Image IR'. This refers to the technical process of modifying, enhancing, or optimizing images after their initial capture or creation."@en ;
          skos:example "Analysis of Gel-Electrophoresis S, Spectral Transform S, 3D Slicer"@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource BRO:T4016 ;
   owl:annotatedProperty skos:definition ;
   owl:annotatedTarget "A 'Data Processing S' for performing post-processing on an 'Image IR'. This refers to the technical process of modifying, enhancing, or optimizing images after their initial capture or creation."@en ;
   BRO:mentions BRO:I3013
 ] .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#T4019
BRO:T4019 rdf:type owl:Class ;
          rdfs:subClassOf BRO:T3018 ;
          rdfs:label "Machine Learning S"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C176231> ,
                       <http://purl.obolibrary.org/obo/OBI_0002587> ;
          skos:altLabel "Machine Learning Software"@en ;
          skos:definition "A 'Modeling and Simulation S' that employs statistical algorithms to progressively improve its ability to perform tasks and generalize unseen data without relying on explicitly encoded rules."@en .


