###  http://bioportal.bioontology.org/ontologies/BRO.owl#P1001
:P1001 rdf:type owl:Class ;
       rdfs:subClassOf :R0001 ;
       rdfs:comment "Not the contact is meant, but the person itself."@en ;
       rdfs:label "People Resource"@en ;
       skos:altLabel "PR"@en ;
       skos:definition "A 'Resource' comprised of one or more individuals providing or exchanging knowledge, experience, or skills in a specific domain."@en .


