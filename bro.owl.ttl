@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix protege: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix activity: <http://bioontology.org/ontologies/Activity.owl#> .
@base <http://bioportal.bioontology.org/ontologies/BRO.owl> .

<http://bioportal.bioontology.org/ontologies/BRO.owl> rdf:type owl:Ontology ;
                                                       owl:versionIRI <http://bioportal.bioontology.org/ontologies/BRO.owl/5.0.0> ;
                                                       <http://purl.org/dc/terms/abstract> "todo" ;
                                                       <http://purl.org/dc/terms/bibliographicCitation> "added after publishing" ;
                                                       <http://purl.org/dc/terms/contributor> "..." ;
                                                       <http://purl.org/dc/terms/created> "" ;
                                                       <http://purl.org/dc/terms/creator> "..." ;
                                                       <http://purl.org/dc/terms/description> "..." ;
                                                       <http://purl.org/dc/terms/language> "en" ;
                                                       <http://purl.org/dc/terms/license> "https://mit-license.org/"^^xsd:anyURI ;
                                                       <http://purl.org/dc/terms/title> "BRO - Biomedical Resource Ontology" ;
                                                       vann:preferredNamespacePrefix "BRO" ;
                                                       vann:preferredNamespaceUri "..." ;
                                                       owl:priorVersion "4.1.1" ;
                                                       owl:versionIRI "http://bioontology.org/ontologies/BiomedicalResources.owl/5.0.0" ;
                                                       owl:versionInfo "5.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://bioontology.org/ontologies/biositemap.owl#definition
desc:definition rdf:type owl:AnnotationProperty ;
                rdfs:range xsd:string .


###  http://bioontology.org/ontologies/biositemap.owl#replacedBy
desc:replacedBy rdf:type owl:AnnotationProperty .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#mentions
BRO:mentions rdf:type owl:AnnotationProperty ;
             rdfs:label "mentions" ;
             skos:definition "Annotation property that includes the IRI of an entity that is referenced." ;
             skos:editorialNote "At the moment only a working version, label and definition of the Annotation might still change." ;
             rdfs:range xsd:anyURI .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/language
<http://purl.org/dc/terms/language> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionIRI
owl:versionIRI rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#editorialNote
skos:editorialNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#historyNote
skos:historyNote rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://bioontology.org/ontologies/biositemap.owl#replacedBy
desc:replacedBy rdf:type owl:ObjectProperty .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#AlgorithmPurpose
BRO:AlgorithmPurpose rdf:type owl:ObjectProperty ;
                     rdfs:comment "DEPRECATED Scientific purpose of algorithm" ,
                                  "Domain Algorithm was deprecated" ;
                     rdfs:label "DEPRECATED AlgorithmPurpose" ;
                     owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#DocumentGoal
BRO:DocumentGoal rdf:type owl:ObjectProperty ;
                 rdfs:comment "DEPRECATED What are the goals of the document" ,
                              "Domain Document was deprecated" ;
                 rdfs:label "DEPRECATED DocumentGoal" ;
                 owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#InteractionType
BRO:InteractionType rdf:type owl:ObjectProperty ;
                    rdfs:comment "DEPRECATED What type of interaction is this?" ,
                                 "no clear usage does exist" ;
                    rdfs:label "DEPRECATED InteractionType" ;
                    owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#MeasurementType
BRO:MeasurementType rdf:type owl:ObjectProperty ;
                    rdfs:comment "DEPRECATED what kind of information is being capture in this measurement?" ,
                                 "Domain Experimental Measurement was deprecated" ;
                    rdfs:label "DEPRECATED MeasurementType" ;
                    owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#OutputForm
BRO:OutputForm rdf:type owl:ObjectProperty ;
               rdfs:comment "DEPRECATED What form of output is produced by this thing" ,
                            "Domain Algorithm was deprecated" ;
               rdfs:label "DEPRECATED OutputForm" ;
               owl:deprecated "true"^^xsd:boolean .


#################################################################
#    Data properties
#################################################################

###  http://bioontology.org/ontologies/biositemap.owl#byline
desc:byline rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:string ;
            rdfs:label "byline" ;
            owl:deprecated "true"^^xsd:boolean .


###  http://bioontology.org/ontologies/biositemap.owl#center
desc:center rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:string ;
            rdfs:comment "there is no usage anymore" ;
            rdfs:label "DEPRECATED Center or Institute" ,
                       "DEPRECATED center" ;
            owl:deprecated "true"^^xsd:boolean .


###  http://bioontology.org/ontologies/biositemap.owl#definition
desc:definition rdf:type owl:DatatypeProperty .


###  http://bioontology.org/ontologies/biositemap.owl#documentation_URL
desc:documentation_URL rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:string ;
                       rdfs:label "documentation URL" ;
                       owl:deprecated "true"^^xsd:boolean .


###  http://bioontology.org/ontologies/biositemap.owl#mailing_list_URL
desc:mailing_list_URL rdf:type owl:DatatypeProperty ;
                      rdfs:range xsd:string ;
                      rdfs:label "mailing list URL" ;
                      owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Identifier
BRO:Identifier rdf:type owl:DatatypeProperty ;
               rdfs:comment "DEPRECATED Any kind of identifier" ,
                            "there is no usage anymore, specific IRI with alphanumerical identifier is used instead" ;
               rdfs:label "DEPRECATED Identifier" ;
               owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Originator
BRO:Originator rdf:type owl:DatatypeProperty ;
               rdfs:domain BRO:Algorithm ;
               rdfs:comment "DEPRECATED Originator of a class" ,
                            "Domain Algorithm was deprecated" ;
               rdfs:label "DEPRECATED Originator" ;
               owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Other_Information
BRO:Other_Information rdf:type owl:DatatypeProperty ;
                      rdfs:domain BRO:Algorithm ;
                      rdfs:comment "Domain Algorithm was deprecated" ;
                      rdfs:label "DEPRECATED Other Information" ,
                                 "DEPRECATED Other_Information" ;
                      owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#PeerReviewStatus
BRO:PeerReviewStatus rdf:type owl:DatatypeProperty ;
                     rdfs:domain BRO:Publication ;
                     rdfs:comment "DEPRECATED is this a peer-reviewed scientific publication?" ,
                                  "Domain Publication was deprecated and level too specific" ;
                     rdfs:label "DEPRECATED PeerReviewStatus" ;
                     owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#ProteinType
BRO:ProteinType rdf:type owl:DatatypeProperty ;
                rdfs:comment "DEPRECATED broad classification of protein type based on structure or function" ,
                             "there is no usage and connectivity anymore" ;
                rdfs:label "DEPRECATED ProteinType" ;
                owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#Target_User_Type
BRO:Target_User_Type rdf:type owl:DatatypeProperty ;
                     rdfs:comment "there is no usage" ;
                     rdfs:label "DEPRECATED Target User Type" ,
                                "DEPRECATED Target_User_Type" ;
                     owl:deprecated "true"^^xsd:boolean .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#TranscriptType
BRO:TranscriptType rdf:type owl:DatatypeProperty ;
                   rdfs:comment "DEPRECATED Type of biological transcript" ,
                                "there is no usage and connectivity anymore" ;
                   rdfs:label "DEPRECATED TranscriptType" ;
                   owl:deprecated "true"^^xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://bioontology.org/ontologies/Activity.owl#Deprecated_Activity
activity:Deprecated_Activity rdf:type owl:Class ;
                             desc:definition "Former subclasses of activity:Activity that have been deprecated and their usage is not recommended." ;
                             rdfs:label "Deprecated Activity" ;
                             owl:deprecated "true"^^xsd:boolean .


###  http://bioontology.org/ontologies/Activity.owl#Heath_Services
activity:Heath_Services rdf:type owl:Class ;
                        rdfs:subClassOf activity:Deprecated_Activity .


###  http://bioontology.org/ontologies/Activity.owl#Novel_Therapeutics
activity:Novel_Therapeutics rdf:type owl:Class ;
                            rdfs:subClassOf activity:Deprecated_Activity .


###  http://bioontology.org/ontologies/ResearchArea.owl#Deprecated_Area_of_Research
area:Deprecated_Area_of_Research rdf:type owl:Class ;
                                 desc:definition "Former subclasses of area:Area_of_Research that have been deprecated and their usage is not recommended." ;
                                 rdfs:label "Deprecated Area of Research" ;
                                 owl:deprecated "true"^^xsd:boolean .


