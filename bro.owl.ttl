       rdfs:subClassOf :M1001 ;
       rdfs:label "Living MR"@en ;
       skos:altLabel "Living Material Resource"@en ;
       skos:definition "A 'Material Resource' of biological origin."@en ;
       skos:example <http://purl.obolibrary.org/obo/mesh#B> .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#M2009
:M2009 rdf:type owl:Class ;
       rdfs:subClassOf :M1001 ;
