BRO:Exploratory_Data_Analysis rdf:type owl:Class .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F1001
BRO:F1001 rdf:type owl:Class ;
          rdfs:subClassOf BRO:R0001 ;
          rdfs:label "Financial Resource"@en ;
          skos:altLabel "FR"@en ;
          skos:definition "A 'Resource' that provides access to monetary support for research, training, or education, including to grants, contracts, materials, or gifts."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F2002
BRO:F2002 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F1001 ;
          rdfs:label "Internal FR"@en ;
          skos:altLabel "Internal Financial Resource"@en ;
          skos:definition "A 'Financial Resource' provided from within the organizational unit, organization, or institution of the applicant."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F2003
BRO:F2003 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F1001 ;
          rdfs:label "Third Party FR"@en ;
          skos:altLabel "Third Party Financial Resource"@en ;
          skos:definition "A 'Financial Resource' provided by an external party."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F3004
BRO:F3004 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F2003 ;
          rdfs:comment "This does not have to be by the public sector where the usage of the 'Financial Resource' is taking place."@en ;
          rdfs:label "Public FR"@en ;
          rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C102434> ;
          skos:altLabel "Public Financial Resource"@en ;
          skos:definition "A 'Third Party FR' provided by a public sector, including the local, city, county, state and federal government, or a transnational group."@en ;
          skos:example "Public Health Care, EU Funding"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F3008
BRO:F3008 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F2003 ;
          rdfs:label "Private FR"@en ;
          skos:altLabel "Private Financial Resource"@en ;
          skos:definition "A 'Third Party FR' provided by a person or organization not from the public sector. It could be made of investments, donations, loans or crowdfunding."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4005
BRO:F4005 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F3004 ;
          rdfs:label "Federal FR"@en ;
          skos:altLabel "Federal Financial Resource"@en ;
          skos:definition "A 'Public FR' provided from the central government of a country or one of its organizations."@en ;
          skos:example "Funding by German Federal Ministry of Research, Technology and Space"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4006
BRO:F4006 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F3004 ;
          rdfs:label "International FR"@en ;
          skos:altLabel "International Financial Resource"@en ;
          skos:definition "A 'Public FR' provided by public institutions of and/or given to beneficiaries from several countries or a transnational group."@en ;
          skos:example "EU Funding"@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4007
BRO:F4007 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F3004 ;
          rdfs:label "State FR"@en ;
          skos:altLabel "State Financial Resource"@en ;
          skos:definition "A 'Public FR' provided by a state or one of its organizations."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4009
BRO:F4009 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F3008 ;
          owl:disjointWith BRO:F4010 ;
          rdfs:label "Institutional FR"@en ;
          skos:altLabel "Institutional Financial Resource"@en ;
          skos:definition "A 'Private FR' provided by a company, organization or foundation."@en .


###  http://bioportal.bioontology.org/ontologies/BRO.owl#F4010
BRO:F4010 rdf:type owl:Class ;
          rdfs:subClassOf BRO:F3008 ;
          rdfs:label "Personal FR"@en ;
          skos:altLabel "Personal Financial Resource"@en ;
          skos:definition "A 'Private FR' provided by one or more human individuals."@en ;
          skos:example "FR by a natural person, foundation of a single person, married couple"@en .


