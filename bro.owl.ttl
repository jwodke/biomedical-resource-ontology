:Genomics_Facility rdf:type owl:Class ;
                   rdfs:comment "level of detail is too specific" ;
                   rdfs:label "DEPRECATED Genomics Facility" ;
                   rdfs:seeAlso :S3008 ;
                   owl:deprecated "true"^^xsd:boolean .


